; Engine configuration file.
; Grand Theft Wheelchair - Godot 4 vertical slice

config_version=5

[application]

config/name="Grand Theft Wheelchair"
config/description="Steal wheelchairs. Catch air. Outroll the Kerb Patrol."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameState="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"
Radio="*res://scripts/radio.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.55, 0.75, 0.95, 1)
